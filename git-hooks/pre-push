#!/usr/bin/env bash
# Pre-push hook — delegates to publish.py --gate for all quality checks.
# Follows the PSS (perfect-skill-suggester) pattern: one script, two modes.
# NOT INSTALLED in this repo (TRDD-D6P88CM1): core.hooksPath=.githooks, whose
# pre-push (process-ancestry check) is strictly stricter. This file is kept as
# the CPV-canonical reference hook — declared divergence in plugin.json
# cpv.pipeline.intentional_divergence.
set -euo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"
if command -v uv &> /dev/null; then
    uv run python scripts/publish.py --gate
else
    python3 scripts/publish.py --gate
fi
exit $?
